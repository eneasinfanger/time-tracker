FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package.json package-lock.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY src/ ./src
COPY tsconfig.json angular.json tailwind.config.cjs postcss.config.cjs ./

# Build the application
RUN npm run build

# Use nginx to serve the built application
FROM nginx:alpine

COPY --from=0 /app/dist/time-tracker /usr/share/nginx/html
COPY nginx.conf /etc/nginx/nginx.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
